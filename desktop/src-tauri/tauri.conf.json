{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NOVEM",
  "version": "1.0.0",
  "identifier": "com.novem.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:all",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "title": "NOVEM — E-Commerce Intelligence Platform",
        "width": 780,
        "height": 380,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "NOVEM — E-Commerce Intelligence Platform",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "NOVEM",
    "copyright": "Copyright © 2026 NOVEM. All rights reserved.",
    "category": "Business",
    "shortDescription": "E-Commerce Intelligence Platform",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "both",
        "displayLanguageSelector": false,
        "startMenuFolder": "NOVEM",
        "compression": "lzma"
      }
    }
  }
}
